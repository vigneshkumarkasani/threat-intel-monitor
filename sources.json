  "github": {
    "_note": "Uses GitHub's official API with the token GitHub Actions provides automatically.",
    "poc_queries": [
      "CVE-2026 in:name",
      "CVE-2025 in:name"
    ],
    "commit_repos": [
      {"repo": "rapid7/metasploit-framework", "name": "Metasploit"},
      {"repo": "projectdiscovery/nuclei-templates", "name": "Nuclei templates"}
    ],
    "advisory_severities": [
      "critical",
      "high"
    ]
  },
  "bluesky": {
    "_note": "Optional. Needs BLUESKY_HANDLE and BLUESKY_APP_PASSWORD secrets. Free.",
    "queries": [
      "CVE exploited",
      "CVE \"in the wild\"",
      "CVE zero-day",
      "CVE ransomware",
      "CVE malware"
    ],
    "limit": 25,
    "every_minutes": 15
  },
  "x": {
    "_note": "Optional and paid (about $0.005 per post read). Needs the X_BEARER_TOKEN secret. Stops for the day at max_reads_per_day.",
    "query": "CVE (exploited OR \"in the wild\" OR zero-day OR 0day OR ransomware OR malware OR botnet OR backdoor OR webshell) -is:retweet -is:reply lang:en",
    "max_reads_per_day": 150,
    "max_per_run": 20
  }
}
