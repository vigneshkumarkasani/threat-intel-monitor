  "github": {
    "_note": "Uses GitHub's official API with the token GitHub Actions provides automatically. PoC search (poc_queries) and exploit-project commits (commit_repos) are switched off; only the advisory database is read.",
    "poc_queries": [],
    "commit_repos": [],
    "advisory_severities": [
      "critical",
      "high"
    ]
  },
  "bluesky": {
    "_note": "Optional. Needs BLUESKY_HANDLE and BLUESKY_APP_PASSWORD secrets. Free.",
    "queries": [
      "CVE exploited",
      "CVE \"in the wild\"",
      "CVE zero-day",
      "CVE ransomware",
      "CVE malware"
    ],
    "limit": 25,
    "every_minutes": 15
  },
  "x": {
    "_note": "Optional and paid (about $0.005 per post read). Needs the X_BEARER_TOKEN secret. Stops for the day at max_reads_per_day.",
    "query": "CVE (exploited OR \"in the wild\" OR zero-day OR 0day OR ransomware OR malware OR botnet OR backdoor OR webshell) -is:retweet -is:reply lang:en",
    "max_reads_per_day": 150,
    "max_per_run": 20
  },
  "malware_news": {
    "_note": "Malware articles that name no CVE. Set alerts to true to get them as instant alerts and in the daily digest. They are still recorded either way, so the dashboard's malware families are unaffected.",
    "alerts": false
  },
  "alerts": {
    "_note": "new_cve_instant decides which plain new CVEs (no sign of exploitation yet) send an instant alert: 'watchlist_critical' = only watchlist products with CVSS >= critical_cvss, 'all' = every one, 'none' = never. The rest always appear in the daily digest. Exploited, malware, KEV and public-exploit alerts are never affected.",
    "new_cve_instant": "watchlist_critical",
    "critical_cvss": 9.0
  }
