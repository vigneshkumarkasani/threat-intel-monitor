  "watchlist": {
    "_note": "Products you care most about. A CVE whose title, summary or description mentions one of these terms gets a 👀 WATCHLIST tag on top of its alert and a first place in the digest. Edit the list freely; matching ignores case. Set mute_other_new_cves to true to deliver plain new-CVE cards for everything else without a notification sound.",
    "terms": ["Fortinet", "FortiOS", "FortiGate", "Palo Alto", "PAN-OS", "Cisco", "Citrix", "NetScaler", "Ivanti", "Microsoft Exchange", "SharePoint", "VMware", "ESXi", "Veeam", "SonicWall"],
    "mute_other_new_cves": false
  },
  "grouping": {
    "_note": "When one run brings this many plain new-CVE alerts (not exploited, no malware, not on the watchlist) for the same vendor, they are sent as a single grouped message. Set to 0 to turn grouping off.",
    "min_alerts_per_vendor": 3
  },
